## Custom headers for the www virtual host (inside location / block)
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-XSS-Protection "1; mode=block" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://rsarrbjsfcugsbaxrnav.supabase.co https://ipapi.co https://restcountries.com;" always;
add_header Permissions-Policy "private-state-token-redemption=(), private-state-token-issuance=(), browsing-topics=()" always;
add_header Strict-Transport-Security "max-age=31536000" always;
